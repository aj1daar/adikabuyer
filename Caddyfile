# CADDY_SITE:
#   prod  -> "adikabuyer.kg"        (Caddy adds automatic HTTPS + Let's Encrypt)
#   local -> "http://localhost"     (plain HTTP, no cert, no HSTS — set by scripts/local.sh)
# CADDY_HSTS: seconds for Strict-Transport-Security (0 disables it, for local).
# CADDY_CSP_TAIL: appended to the CSP ("; upgrade-insecure-requests" for HTTPS, empty for HTTP).
{$CADDY_SITE:localhost} {
    encode gzip

    @www host www.{$DOMAIN:localhost}
    redir @www {scheme}://{$DOMAIN:localhost}{uri} permanent

    header {
        Strict-Transport-Security "max-age={$CADDY_HSTS:31536000}; includeSubDomains"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Permissions-Policy "camera=(), microphone=(), geolocation=(), browsing-topics=()"
        # Scripts stay strict ('self'). style-src needs 'unsafe-inline' (framer-motion +
        # inline style props) and fonts.googleapis.com for the Unbounded/Space Grotesk
        # @import in index.css; the font files come from fonts.gstatic.com.
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https: http:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'{$CADDY_CSP_TAIL:; upgrade-insecure-requests}"
        -Server
    }

    handle /api/* {
        reverse_proxy api-gateway:8080 {
            # Caddy is the only ingress (gateway/services publish no host ports).
            # Overwrite the client's forwarding headers with the real TCP peer, and
            # stamp X-Real-Ip separately: Spring Cloud Gateway rewrites X-Forwarded-*
            # per CVE-2025-41235, but passes X-Real-Ip straight through to the app,
            # which keys the login rate limiter on it.
            header_up X-Real-Ip {http.request.remote.host}
            header_up X-Forwarded-For {http.request.remote.host}
            header_up -Forwarded
            header_up -X-Forwarded-Host
        }
    }

    handle_path /media/* {
        # Force download rather than inline render — neutralises any non-image object
        # that predates upload validation (e.g. an SVG stored before magic-byte checks).
        # <img> subresource loads ignore Content-Disposition, so product images still show.
        header Content-Disposition attachment
        reverse_proxy minio:9000
    }

    handle {
        root * /srv/www
        try_files {path} /index.html
        file_server
    }
}
