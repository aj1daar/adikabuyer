{$DOMAIN:localhost} {
    encode gzip

    header {
        # HSTS (Caddy also sets this automatically on TLS; explicit for includeSubDomains).
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Permissions-Policy "camera=(), microphone=(), geolocation=(), browsing-topics=()"
        # SPA is fully same-origin (hashed /assets/*.js + *.css, /api, /media). 'unsafe-inline'
        # for style-src only, needed by framer-motion and inline style props; script stays strict.
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        -Server
    }

    handle /api/* {
        reverse_proxy api-gateway:8080 {
            # Caddy is the only ingress (gateway/services publish no host ports).
            # Overwrite the client's forwarding headers with the real TCP peer, and
            # stamp X-Real-Ip separately: Spring Cloud Gateway rewrites X-Forwarded-*
            # per CVE-2025-41235, but passes X-Real-Ip straight through to the app,
            # which keys the login rate limiter on it.
            header_up X-Real-Ip {http.request.remote.host}
            header_up X-Forwarded-For {http.request.remote.host}
            header_up -Forwarded
            header_up -X-Forwarded-Host
        }
    }

    handle_path /media/* {
        # Force download rather than inline render — neutralises any non-image object
        # that predates upload validation (e.g. an SVG stored before magic-byte checks).
        # <img> subresource loads ignore Content-Disposition, so product images still show.
        header Content-Disposition attachment
        reverse_proxy minio:9000
    }

    handle {
        root * /srv/www
        try_files {path} /index.html
        file_server
    }
}

www.{$DOMAIN:localhost} {
    redir https://{$DOMAIN:localhost}{uri} permanent
}
