DOMAIN=adikabuyer.kg
# Caddy site address(es). Include www so the www->apex redirect fires.
CADDY_SITE=adikabuyer.kg, www.adikabuyer.kg
CORS_ALLOWED_ORIGIN=https://adikabuyer.kg

# Optional Caddy tuning (defaults are production-safe: HSTS 1y, CSP upgrades to HTTPS):
#   CADDY_HSTS=31536000
#   CADDY_CSP_TAIL=; upgrade-insecure-requests

# Every value below MUST be replaced with a real, unique secret before deploying.
# The compose file only checks that these are non-empty (`:?`), NOT that they are
# strong — shipping a placeholder verbatim is a real vulnerability, not a warning.
# Generate each secret fresh:  openssl rand -base64 30

POSTGRES_USER=adikabuyer
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_base64_30
POSTGRES_DB=adikabuyer

RABBITMQ_USER=adikabuyer
RABBITMQ_PASSWORD=CHANGE_ME_openssl_rand_base64_30

MINIO_ROOT_USER=adikabuyer
MINIO_ROOT_PASSWORD=CHANGE_ME_openssl_rand_base64_30
S3_BUCKET=adikabuyer-media
S3_PUBLIC_URL_BASE=https://adikabuyer.kg/media/adikabuyer-media

# openssl rand -hex 48
APP_JWT_SECRET=CHANGE_ME_openssl_rand_hex_48
APP_SECURITY_ADMIN_USERNAME=admin
# htpasswd -bnBC 12 "" 'YOUR_STRONG_PASSWORD' | tr -d ':\n' | sed 's/^\$2y/\$2a/'
# then escape every $ as $$ for docker-compose interpolation
APP_SECURITY_ADMIN_PASSWORD_HASH=CHANGE_ME_bcrypt_hash_with_dollar_signs_escaped_as_dollar_dollar

TELEGRAM_BOT_TOKEN=replace-with-the-bot-token-from-BotFather
TELEGRAM_REGISTRATION_PASSWORD=CHANGE_ME_openssl_rand_base64_24

CATALOG_SERVICE_JAVA_OPTS=-Xmx256m -Xms128m
ORDER_SERVICE_JAVA_OPTS=-Xmx256m -Xms128m
GATEWAY_JAVA_OPTS=-Xmx256m -Xms128m
